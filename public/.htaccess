# ---------------------------------------------------------
# ALTERVISTA APACHE CONFIGURATION & SECURITY HARDENING
# ---------------------------------------------------------

# Prevent directory indexing / directory listing
Options -Indexes

# Serve custom 404 page generated by Next.js static export
ErrorDocument 404 /404/index.html

# Block access to hidden files and directories (e.g. .git, .env, .htaccess)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to sensitive source and configuration files
<FilesMatch "\.(md|lock|yml|yaml|bak|config|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Ensure extensionless site-data is served as application/json
<Files "site-data">
    ForceType application/json
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</Files>

# ---------------------------------------------------------
# HTTP SECURITY HEADERS
# ---------------------------------------------------------
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Prevent clickjacking by restricting framing
    Header always set X-Frame-Options "SAMEORIGIN"

    # Send strict referrer information
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict unneeded browser hardware access
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Enable legacy XSS filter protection
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ---------------------------------------------------------
    # 1. FORCE HTTPS (AlterVista specific routing)
    # ---------------------------------------------------------
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # ---------------------------------------------------------
    # 2. NEXT.JS STATIC EXPORT ROUTING (trailingSlash: true)
    # ---------------------------------------------------------
    # If the requested URI is a directory without trailing slash, redirect with slash
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} !(/$|\.)
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [L,R=301]

    # If the corresponding folder/index.html exists
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
    RewriteRule ^(.*)$ $1/index.html [L]

    # Fallback if a .html file exists
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>
